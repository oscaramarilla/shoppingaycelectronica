# ============================================================
# Variables de entorno — shoppingaycelectronica
# Copiar como .env.local y completar. NUNCA commitear .env.local.
# Server-side únicamente: ninguna usa el prefijo NEXT_PUBLIC_.
# ============================================================

# Supabase (proyecto PROPIO, separado de AYCweb)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL canónica del sitio, usada por metadata, robots y sitemap.
SITE_URL=http://localhost:3000

# Acceso HTTP Basic para /gestion y /api/admin/*.
ADMIN_USER=
ADMIN_PASS=

# Kapso — WhatsApp (número DEDICADO, API-only)
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=

# Secreto compartido para autenticar los webhooks de Kapso hacia estos endpoints
KAPSO_WEBHOOK_SECRET=
